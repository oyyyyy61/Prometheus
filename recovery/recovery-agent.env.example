# Copy to /etc/agentrix/recovery-agent.env and chmod 600.
RECOVERY_AGENT_TOKEN=replace-with-a-long-random-token
RECOVERY_BRIDGE_UNIT=agentrix-vllm-bridge.service
RECOVERY_VLLM_UNIT=vllm.service
RECOVERY_CHECKPOINT_SOURCE=/data/Agentrix/checkpoints/latest.pt
RECOVERY_CHECKPOINT_TARGET=/data/Agentrix/checkpoints/active.pt
